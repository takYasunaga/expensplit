# Copy to .env.local and fill in from Supabase > Project Settings > API.
# Without these the app runs on the sample data in src/mockData.ts.
# The key may also be named VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Receipt scanning (Google AI Studio key). Anything prefixed VITE_ is bundled
# into the browser code, so this key is visible to anyone using the app.
VITE_GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-flash-latest).
# VITE_GEMINI_MODEL=
